# Copy to .env and set these values for your local installation.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=restaurant_pos

# Comma-separated exact frontend origins. Add each LAN browser origin when using the POS over a LAN.
APP_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173

# Enable only when the POS is served over HTTPS.
COOKIE_SECURE=false
